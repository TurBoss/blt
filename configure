ac_aux_dir=
for ac_dir in cf "$srcdir"/cf; do
  if test -f "$ac_dir/install-sh"; then
    ac_aux_dir=$ac_dir
    ac_install_sh="$ac_aux_dir/install-sh -c"
    break
  elif test -f "$ac_dir/install.sh"; then
    ac_aux_dir=$ac_dir
    ac_install_sh="$ac_aux_dir/install.sh -c"
    break
  elif test -f "$ac_dir/shtool"; then
    ac_aux_dir=$ac_dir
    ac_install_sh="$ac_aux_dir/shtool install -c"
    break
  fi
done
if test -z "$ac_aux_dir"; then
  { { $as_echo "$as_me:$LINENO: error: cannot find install-sh or install.sh in cf \"$srcdir\"/cf" >&5
$as_echo "$as_me: error: cannot find install-sh or install.sh in cf \"$srcdir\"/cf" >&2;}
   { (exit 1); exit 1; }; }
fi

